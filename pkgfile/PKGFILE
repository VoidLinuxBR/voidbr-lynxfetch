#!/usr/bin/env bash
# Maintainer: Vilmar Catafesta <vcatafesta@gmail.com>

pkgname=voidbr-lynxfetch
pkgdesc="Super fast, versatile, and customizable command-line fetcher."
pkgver=$(date +%Y%m%d)
pkgrel=$(date +%H%M)
arch=('any')
license=('MIT')
#url="ssh://git@github.com/voidlinuxbr/${pkgname}"
url="https://github.com/voidlinuxbr/${pkgname}"
source=("git+${url}.git")
md5sums=('SKIP')
makedepends=()
depends=()

package() {
	cd "${srcdir}/${pkgname}"
	#	# Instala todos os arquivos em /usr/share/${pkgname} no momento da criação do pacote
	#	install -dm755 "${pkgdir}/usr/share/${pkgname}"
	#	# Lista de pacotes instalados automaticamente via post_install
	#	# (não confundir com optdepends do PKGBUILD)
	#	if ((${#post_install_pkgs[@]})); then
	#		printf "%s\n" "${post_install_pkgs[@]}" >"${pkgdir}/usr/share/${pkgname}/optdepends"
	#	fi

	# Copiar a estrutura de /etc, /usr e /opt para /usr/share/${pkgname}
	local dirs=("usr" "etc" "opt")
	for dir in "${dirs[@]}"; do
		if [ -d "${srcdir}/${pkgname}/${dir}" ]; then
			cp -a "${srcdir}/${pkgname}/${dir}" "${pkgdir}/"
		fi
	done

	# Verify default folder
	if [ -d "${srcdir}/${pkgname}/${pkgname}" ]; then
		InternalDir="${srcdir}/${pkgname}/${pkgname}"
	else
		InternalDir="${srcdir}/${pkgname}"
	fi

	# Copiar a estrutura de /etc, /usr e /opt para /
	local dirs=("usr" "etc" "opt")
	for dir in "${dirs[@]}"; do
		if [ -d "${InternalDir}/${dir}" ]; then
			cp -a "${InternalDir}/${dir}" "${pkgdir}/"
		fi
	done

	# Install license file if present
	if [ -f "LICENSE" ]; then
		install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
	fi

	# Install documentation if present
	if [ -f "README.md" ]; then
		install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
	fi
}

pre_install() {
	log "Iniciando instalação"
}

post_install() {
	if [ "${update:-}" = "yes" ]; then
		log "Finalizando upgrade"
	else
		log "Finalizando instalação"
	fi

}

pre_upgrade() {
	log "Iniciando upgrade"
}


post_upgrade() {
	post_install
}
